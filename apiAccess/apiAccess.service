[Unit]
Description=apiAccess Service by @Rufu99
After=network.target nss-lookup.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/root/ADMRufu/apiAccess/apiAccess
ExecStartPre=/root/ADMRufu/apiAccess/autoLic
Restart=on-failure
