#!/usr/bin/env python3
import base64, re, subprocess, sys, os

KEY = 'VnBjMnTlL'
PATH = '/etc/ADMRufuLIC'

def fetch_ip():
    cmds = [
        ['curl', '-s', '-m', '6', 'https://api.ipify.org'],
        ['curl', '-s', '-m', '6', 'http://ip1.dynupdate.no-ip.com'],
        ['sh', '-c', 'curl -s -m 6 https://cloudflare.com/cdn-cgi/trace | sed -n "s/^ip=//p"'],
    ]
    for cmd in cmds:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=9)
            ip = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ''
            if re.fullmatch(r'\d{1,3}(\.\d{1,3}){3}', ip) or ':' in ip:
                return ip
        except Exception:
            continue
    return None

def enc(ip):
    raw = bytes(ord(c) ^ ord(KEY[i % len(KEY)]) for i, c in enumerate(ip))
    return base64.b64encode(raw)

def main():
    ip = fetch_ip()
    if not ip:
        sys.exit(0)
    new = enc(ip)
    try:
        with open(PATH, 'rb') as f:
            old = f.read().strip()
    except FileNotFoundError:
        old = b''
    if old == new:
        return
    with open(PATH, 'wb') as f:
        f.write(new)
    os.chmod(PATH, 0o600)
    print('autoLic: licencia regenerada para', ip, flush=True)

if __name__ == '__main__':
    main()